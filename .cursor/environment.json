{
  "baseImage": "ghcr.io/cursor-images/node-20:latest",
  "install": "bash scripts/cloud-agent-install.sh",
  "start": "bash scripts/cloud-agent-start.sh",
  "persistedDirectories": [
    "/workspace/.pnpm-store",
    "/workspace/.turbo"
  ],
  "env": {
    "CI": "true",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "DB_NOTES_TEST_URL": "postgres:///notes_test?host=/var/run/postgresql",
    "DB_NOTES_URL": "postgres:///notes?host=/var/run/postgresql",
    "HUSKY": "0",
    "PNPM_HOME": "/home/ubuntu/.local/share/pnpm",
    "PNPM_STORE_DIR": "/workspace/.pnpm-store",
    "TURBO_TELEMETRY_DISABLED": "1"
  }
}
