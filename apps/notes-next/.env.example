AUTH_TRUST_HOST="true"/"false"

# Password reset SMS uses the Paul contact form's Twilio sender and recipient.
# Configure TWILIO_AUTH_TOKEN or both TWILIO_API_KEY_SID and TWILIO_API_KEY_SECRET.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_FROM_NUMBER=""
TWILIO_TO_NUMBER=""
